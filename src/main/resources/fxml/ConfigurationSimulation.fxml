<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.app.controller.ConfigurationSimulationController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #071018, #102637, #06111f);">

    <center>
        <VBox alignment="CENTER" spacing="22">

            <VBox alignment="CENTER"
                  spacing="18"
                  maxWidth="470"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-border-color: rgba(0,229,255,0.65);
                         -fx-border-radius: 18;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.25), 28, 0, 0, 8);">

                <padding>
                    <Insets top="38" right="36" bottom="36" left="36"/>
                </padding>

                <Label text="Configuration Simulation"
                       style="-fx-text-fill: white;
                              -fx-font-size: 30px;
                              -fx-font-weight: bold;"/>

                <Label text="Préparez l'environnement, les conditions et les capteurs"
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-text-fill: #d8f6ff;
                              -fx-font-size: 14px;"/>

                <Separator/>

                <VBox spacing="8" maxWidth="Infinity">
                    <Label text="Environnement"
                           style="-fx-text-fill: #00e5ff; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="environmentComboBox"
                              promptText="Choisir un environnement"
                              prefHeight="44"
                              maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" maxWidth="Infinity">
                    <Label text="Condition environnementale"
                           style="-fx-text-fill: #00e5ff; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="conditionComboBox"
                              promptText="Choisir une condition"
                              prefHeight="44"
                              maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" maxWidth="Infinity">
                    <Label text="Visibilité / Turbidité"
                           style="-fx-text-fill: #00e5ff; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="visibilityComboBox"
                              promptText="Choisir le niveau de visibilité"
                              prefHeight="44"
                              maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" maxWidth="Infinity">
                    <Label text="Capteur principal"
                           style="-fx-text-fill: #00e5ff; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="sensorComboBox"
                              promptText="Choisir un capteur"
                              prefHeight="44"
                              maxWidth="Infinity"/>
                </VBox>

                <Button text="Continuer vers la sélection du drone"
                        onAction="#handleContinue"
                        prefHeight="48"
                        maxWidth="Infinity"
                        style="-fx-background-color: linear-gradient(to right, #00bcd4, #2563eb);
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Label fx:id="statusLabel"
                       text=""
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-text-fill: #ffcc80;"/>

            </VBox>
        </VBox>
    </center>
</BorderPane>