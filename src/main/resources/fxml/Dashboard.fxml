<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.app.controller.DashboardController"
      style="-fx-background-color: #071018;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="DronSim Pilot Station"
           style="-fx-text-fill: white;
                  -fx-font-size: 28px;
                  -fx-font-weight: bold;"/>

    <HBox spacing="20">

        <VBox spacing="10"
              prefWidth="350"
              style="-fx-background-color: #101820;
                     -fx-padding: 15;
                     -fx-border-color: #ffc107;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;">

            <Label text="Télémétrie Drone"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>
            <Label fx:id="positionLabel"
                   text="Position : x=0 | y=0 | z=0"
                   style="-fx-text-fill: white;"/>

            <Label fx:id="speedLabel"
                   text="Vitesse : 0 m/s"
                   style="-fx-text-fill: white;"/>

            <Label fx:id="temperatureLabel"
                   text="Température : 0 °C"
                   style="-fx-text-fill: white;"/>

            <Label fx:id="depthLabel"
                   text="Profondeur : 0 m"
                   style="-fx-text-fill: white;"/>

            <Label fx:id="intensityLabel"
                   text="Intensité : 0"
                   style="-fx-text-fill: white;"/>

            <Label fx:id="stateLabel"
                   text="État : En attente"
                   style="-fx-text-fill: white;"/>

            <Label text="Batterie : 100%"
                   style="-fx-text-fill: white;"/>

        </VBox>

        <VBox spacing="10"
              prefWidth="450"
              prefHeight="280"
              style="-fx-background-color: black;
                     -fx-padding: 15;
                     -fx-border-color: #9c27b0;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;">

            <Label text="Retour caméra simulé"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

            <Label text="CAMERA FEED&#10;(simulateur)"
                   style="-fx-text-fill: #00ff99;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;"/>

        </VBox>

    </HBox>

    <GridPane hgap="10"
              vgap="10"
              style="-fx-background-color: #101820;
                     -fx-padding: 15;
                     -fx-border-color: #4caf50;
                     -fx-border-radius: 8;
                     -fx-background-radius: 8;">

        <Label text="Commandes de pilotage"
               style="-fx-text-fill: white;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;"
               GridPane.columnSpan="3"/>

        <Button text="▲ Avancer"
                onMousePressed="#moveForward"
                onMouseReleased="#stopDrone"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"/>

        <Button text="◀ Gauche"
                onMousePressed="#moveLeft"
                onMouseReleased="#stopDrone"
                GridPane.rowIndex="2"/>

        <Button text="STOP"
                onAction="#stopDrone"
                GridPane.columnIndex="1"
                GridPane.rowIndex="2"/>

        <Button text="Droite ▶"
                onMousePressed="#moveRight"
                onMouseReleased="#stopDrone"
                GridPane.columnIndex="2"
                GridPane.rowIndex="2"/>

        <Button text="▼ Reculer"
                onMousePressed="#moveBackward"
                onMouseReleased="#stopDrone"
                GridPane.columnIndex="1"
                GridPane.rowIndex="3"/>

        <Button text="Monter"
                onMousePressed="#moveUp"
                onMouseReleased="#stopDrone"
                GridPane.rowIndex="4"/>

        <Button text="Descendre"
                onMousePressed="#moveDown"
                onMouseReleased="#stopDrone"
                GridPane.columnIndex="2"
                GridPane.rowIndex="4"/>

        <Button text="Lancer simulation"
                onAction="#startSimulation"
                GridPane.columnIndex="0"
                GridPane.rowIndex="5"
                GridPane.columnSpan="3"/>

    </GridPane>

    <Label text="Journal des actions"
           style="-fx-text-fill: white;
                  -fx-font-size: 18px;
                  -fx-font-weight: bold;"/>

    <TextArea fx:id="logArea"
              editable="false"
              prefHeight="180"/>

</VBox>