<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.dronsim</groupId>
    <artifactId>dronsim</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>DronSim</name>
    <description>Simulateur de drones réaliste, multi-milieux et multi-agent</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jme3.groupId>org.jmonkeyengine</jme3.groupId>
        <jme3.version>3.7.0-stable</jme3.version>

        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>

        <junit.version>5.12.1</junit.version>
        <monkeywrench.version>0.6.2</monkeywrench.version>
    </properties>

    <dependencies>

        <!-- JavaFX (à activer plus tard pour l'interface graphique) -->

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21</version>
        </dependency>


        <!-- JMonkeyEngine - core -->
        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-core</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-desktop</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-lwjgl3</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <!-- JMonkeyEngine  -->
        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-effects</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-jbullet</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-jogg</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-networking</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-niftygui</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-plugins</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-terrain</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-testdata</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <dependency>
            <groupId>${jme3.groupId}</groupId>
            <artifactId>jme3-vr</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <!-- GLTF / GLB / OBJ / FBX asset loading -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>MonkeyWrench</artifactId>
            <version>${monkeywrench.version}</version>
        </dependency>
<!--
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Minie</artifactId>
            <version>9.0.3+mt</version>
        </dependency>
-->
        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Jackson JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Java 17 compilation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>

            <!-- Plugin pour exécuter l'application JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>fr.app.InterfacePilote</mainClass>
                    <options>
                        <option>-Dglass.win.uiScale=100%</option>

                        <option>-Dglass.gtk.uiScale=100%</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>